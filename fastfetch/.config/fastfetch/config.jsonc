{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "templeos", //why? beause the icon goes hard 
    "type": "auto",
    "padding": {
      "top": 1,
      "left": 3
    }
  },
  "display": {
    "separator": "  ->  ",
    "color": {
      "keys": "magenta",
      "title": "white",
      "output": "",
      "separator": "white"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "packages",
    "shell",
    "terminal",
    "separator",
    "uptime",
    "cpu",
    "gpu",
    "board",
    "processes",
    "memory",
    "swap",
    "separator",
    "uptime",
    "datetime",
    {
    "type": "command",
    "key": "OS Age",
    "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    "separator",
    "colors"
  ]
}
